---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import { BLUEPRINT_URL, CTA_LABEL } from '../lib/cta';
import {
  ArrowRight,
  Check,
  X,
  Inbox,
  PhoneCall,
  HeartHandshake,
  PenLine,
  BarChart3,
  ClipboardList,
  Brain,
  Cloud,
  Eye,
  ShieldCheck,
  Scale,
  Sparkles,
  Building2,
  Briefcase,
  GraduationCap,
  Rocket,
  ClipboardCheck,
  ChevronDown,
  Lock,
  CheckCircle2,
} from 'lucide-react';
---
<Layout
  title="VibeControl — Your AI workforce, running your business"
  description="Hire an AI office manager, sales assistant, or customer support rep for your small business. Starts with a $47 Blueprint that maps your AI workforce and builds your team."
>
  <SiteNav />

  <main id="top" class="pt-16">
    <!-- =========================
         SECTION 1 — HERO
         ========================= -->
    <section class="relative overflow-hidden">
      <!-- ambient glow -->
      <div class="absolute top-10 left-1/4 w-[28rem] h-[28rem] bg-brand-blue/20 rounded-full blur-[140px]" aria-hidden="true"></div>
      <div class="absolute bottom-0 right-1/4 w-[26rem] h-[26rem] bg-brand-teal/20 rounded-full blur-[140px]" aria-hidden="true"></div>
      <div class="absolute top-1/3 right-1/3 w-72 h-72 bg-brand-orange/10 rounded-full blur-[120px]" aria-hidden="true"></div>

      <div class="relative max-w-5xl mx-auto px-6 pt-20 pb-24 sm:pt-28 sm:pb-32 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs sm:text-sm text-gray-300 mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-teal animate-pulse"></span>
          <span class="text-brand-teal font-semibold">Launching Soon</span>
          <span class="text-gray-600">·</span>
          For business owners asking where to start with AI
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-[1.05]">
          Your business doesn't need
          <span class="block bg-gradient-to-r from-brand-blue via-brand-teal to-brand-orange bg-clip-text text-transparent">
            more software.
          </span>
          <span class="text-gray-200">It needs more workers.</span>
        </h1>

        <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          VibeControl gives you an AI workforce that actually runs the work —
          answers your emails, follows up with leads, keeps your CRM clean,
          writes your reports. For less than a part-time VA.
        </p>

        <div class="flex flex-col items-center gap-3">
          <a
            href={BLUEPRINT_URL}
            class="group inline-flex items-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-xl shadow-brand-blue/30"
          >
            {CTA_LABEL}
            <ArrowRight className="w-5 h-5 group-hover:translate-x-0.5 transition" />
          </a>
          <p class="text-sm text-gray-400 max-w-md">
            A $47 guided session that maps your AI workforce and shows you the
            workers your business should hire first.
            <span class="block mt-1 text-gray-500">Launching soon — claim your spot on the list.</span>
          </p>
        </div>

        <!-- micro-trust row -->
        <div class="mt-14 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs text-gray-500">
          <span class="flex items-center gap-1.5"><Lock className="w-3.5 h-3.5" /> No credit card to join the list</span>
          <span class="hidden sm:inline">·</span>
          <span class="flex items-center gap-1.5"><CheckCircle2 className="w-3.5 h-3.5" /> 14-day Value Promise at launch</span>
          <span class="hidden sm:inline">·</span>
          <span class="flex items-center gap-1.5"><Sparkles className="w-3.5 h-3.5" /> First-in-line pricing</span>
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 2 — JTBD COMPARISON
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center mb-16">
          <div>
            <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">What's different about VibeControl</p>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
              You've already tried AI. It still ended up back on your plate.
            </h2>
            <div class="space-y-4 text-gray-300 text-lg leading-relaxed">
              <p>
                ChatGPT for drafting things. Maybe an AI feature inside your CRM.
                Maybe an automation tool. They help — but the work still ends up
                back on your plate.
              </p>
              <p>
                Every AI tool you've used so far has been built to
                <em class="text-gray-100 not-italic font-medium">help you think</em>
                about work. VibeControl is built to
                <em class="text-white not-italic font-semibold">do the work</em>.
              </p>
            </div>
          </div>

          <!-- Logo lockup -->
          <div class="relative hidden lg:block">
            <div class="absolute inset-0 bg-[radial-gradient(closest-side,rgba(74,144,217,0.22),rgba(77,201,160,0.12)_55%,transparent_75%)] blur-2xl" aria-hidden="true"></div>
            <div class="relative aspect-square max-w-sm mx-auto rounded-3xl bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/10 backdrop-blur-md p-10 flex items-center justify-center">
              <img src="/images/logos/vibecontrol-dark-500x300.svg" alt="VibeControl" class="w-full h-auto max-w-[16rem] drop-shadow-[0_8px_32px_rgba(74,144,217,0.35)]" />
            </div>
          </div>
        </div>

        <div class="space-y-4">
          {[
            { left: 'ChatGPT', leftDoes: 'gives you advice.', right: 'does the work.', sub: 'One drafts emails you still have to send. The other answers them.' },
            { left: 'Zapier', leftDoes: 'connects your apps.', right: 'runs your business.', sub: 'One moves data between tools. The other makes decisions and takes action.' },
            { left: 'Your CRM', leftDoes: 'stores your customers.', right: 'talks to them.', sub: 'One is a database. The other is a sales assistant who never forgets to follow up.' },
            { left: 'Your project tool', leftDoes: 'tracks tasks.', right: 'completes them.', sub: 'One is a list. The other is a team.' },
            { left: 'A virtual assistant', leftDoes: 'costs $2,000+ a month.', right: 'costs $97.', sub: 'One needs to be hired, trained, managed, and paid. The other shows up already knowing your business.' },
          ].map((row) => (
            <div class="group relative rounded-2xl bg-white/[0.03] border border-white/10 hover:border-brand-teal/30 transition-all overflow-hidden">
              <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-stretch">
                <!-- LEFT: competitor -->
                <div class="relative p-6 md:p-8">
                  <div class="flex items-start gap-3">
                    <div class="hidden md:flex w-9 h-9 shrink-0 rounded-lg bg-white/[0.04] border border-white/10 items-center justify-center mt-0.5">
                      <X className="w-4 h-4 text-gray-500" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Today</p>
                      <p class="text-gray-300 text-lg leading-snug">
                        <span class="font-bold text-white">{row.left}</span>
                        {' '}<span class="text-gray-400">{row.leftDoes}</span>
                      </p>
                    </div>
                  </div>
                </div>

                <!-- VS divider -->
                <div class="hidden md:flex items-center justify-center px-2">
                  <div class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-950 border border-white/10 text-xs font-bold text-gray-500 tracking-wider">
                    vs
                  </div>
                </div>
                <div class="md:hidden h-px bg-gradient-to-r from-transparent via-white/10 to-transparent mx-6"></div>

                <!-- RIGHT: VibeControl -->
                <div class="relative p-6 md:p-8 bg-gradient-to-br from-brand-blue/[0.08] via-brand-teal/[0.05] to-transparent">
                  <div class="flex items-start gap-3">
                    <div class="hidden md:flex w-9 h-9 shrink-0 rounded-lg bg-brand-teal/15 border border-brand-teal/30 items-center justify-center mt-0.5">
                      <Check className="w-4 h-4 text-brand-teal" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-brand-teal uppercase tracking-wider mb-1.5">VibeControl</p>
                      <p class="text-white text-lg leading-snug font-semibold">{row.right}</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="border-t border-white/5 px-6 md:px-8 py-4 bg-black/20">
                <p class="text-sm text-gray-500 italic leading-relaxed">{row.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 3 — WHAT'S ACTUALLY IN IT
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6 overflow-hidden">
      <div class="absolute top-1/2 -translate-y-1/2 -left-40 w-96 h-96 bg-brand-blue/10 rounded-full blur-[120px]" aria-hidden="true"></div>

      <div class="relative max-w-6xl mx-auto">
        <div class="max-w-3xl mb-16 text-center mx-auto">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">Your AI workforce, working</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
            Assign work the way you'd assign it to a person.
            <span class="text-gray-400">The work gets done.</span>
          </h2>
        </div>

        <!-- Roles -->
        <p class="text-center text-gray-300 text-lg mb-10 font-medium">Hire workers for the jobs that fill your day.</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-20">
          {[
            { icon: Inbox, color: 'brand-blue', role: 'AI Office Manager', desc: 'Reads your inbox, books your meetings, and flags what needs you.' },
            { icon: PhoneCall, color: 'brand-teal', role: 'AI Sales Assistant', desc: 'Follows up with every lead, books calls, and updates your CRM.' },
            { icon: HeartHandshake, color: 'brand-orange', role: 'AI Customer Support', desc: 'Handles routine questions and routes the complex ones to you.' },
            { icon: PenLine, color: 'brand-coral', role: 'AI Content Writer', desc: 'Drafts your emails, newsletters, and follow-up sequences in your voice.' },
            { icon: BarChart3, color: 'brand-blue', role: 'AI Reports Analyst', desc: 'Pulls your numbers and writes the summary — Monday before you log on.' },
          ].map(({ icon: Icon, color, role, desc }) => (
            <div class="p-5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-white/25 hover:bg-white/[0.06] transition group">
              <div class={`w-10 h-10 rounded-xl bg-${color}/15 flex items-center justify-center mb-4 group-hover:scale-105 transition`}>
                <Icon className={`w-5 h-5 text-${color}`} />
              </div>
              <h3 class="font-semibold text-white mb-2 leading-snug">{role}</h3>
              <p class="text-sm text-gray-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>

        <!-- Capability blocks -->
        <div class="grid md:grid-cols-2 gap-5">
          {[
            { icon: ClipboardList, color: 'brand-blue', title: 'Each worker has a job description.', body: 'What they do, what they don’t, how much judgment they’re trusted with. Built specifically for your business — not generic templates.' },
            { icon: Brain, color: 'brand-teal', title: 'They remember.', body: 'Your workers learn your customers, your decisions, your way of doing things. The longer they work for you, the better they get. Hire a new VA and your AI team brings them up to speed.' },
            { icon: Cloud, color: 'brand-orange', title: 'They work while you sleep.', body: 'VibeControl runs in the cloud, on our infrastructure. Nothing to install. Your AI team keeps working whether your computer is open or not.' },
            { icon: Eye, color: 'brand-coral', title: 'You see everything they’re doing.', body: 'Open the app from your phone or laptop and you see exactly what your AI team has handled, what’s in progress, and what’s waiting for you.' },
            { icon: ShieldCheck, color: 'brand-blue', title: 'Nothing happens you didn’t authorize.', body: 'You decide what each worker is allowed to do on their own and what needs your approval. Email drafts can wait for review. Customer responses can send automatically. You set the rules.' },
            { icon: Scale, color: 'brand-teal', title: 'You stay in charge of the judgment calls.', body: 'AI workers handle routine work end-to-end. Pricing, strategy, hard customer conversations — those stay with you. Always.' },
          ].map(({ icon: Icon, color, title, body }) => (
            <div class="p-7 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md hover:border-white/20 transition">
              <div class="flex items-start gap-4">
                <div class={`w-11 h-11 shrink-0 rounded-xl bg-${color}/15 flex items-center justify-center`}>
                  <Icon className={`w-5 h-5 text-${color}`} />
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-white mb-2 leading-snug">{title}</h3>
                  <p class="text-gray-400 leading-relaxed">{body}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Product placeholder -->
        <figure class="mt-16 rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-white/[0.02] p-2 backdrop-blur-md">
          <div class="aspect-[16/9] rounded-2xl bg-gradient-to-br from-gray-900 via-gray-950 to-gray-900 border border-white/5 flex items-center justify-center overflow-hidden relative">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(74,144,217,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(74,144,217,0.05)_1px,transparent_1px)] bg-[size:32px_32px]"></div>
            <div class="relative text-center px-6">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-gray-400 mb-4">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal"></span>
                Live dashboard preview
              </div>
              <p class="text-gray-300 max-w-md mx-auto">
                Your AI team's work — what they handled, what's in progress, what's waiting on you. All in one place.
              </p>
            </div>
          </div>
          <figcaption class="text-center text-xs text-gray-500 pt-3 pb-1">
            The VibeControl dashboard. Your AI team's work, visible.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- =========================
         SECTION 4 — HOW YOU GET STARTED
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">How you get started</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
            One door in. <span class="bg-gradient-to-r from-brand-blue to-brand-teal bg-clip-text text-transparent">The Blueprint.</span>
          </h2>
          <p class="text-lg text-gray-300 leading-relaxed max-w-2xl mx-auto">
            The fastest way to find out what VibeControl can do for your business
            is through Roleforge — a $47 guided session that maps the AI workforce
            your business actually needs.
          </p>
        </div>

        <div class="rounded-3xl bg-gradient-to-br from-brand-blue/10 via-white/[0.03] to-brand-teal/10 border border-white/10 p-8 md:p-12 backdrop-blur-md">
          <p class="text-gray-300 leading-relaxed mb-8">
            You sit down with an AI consultant. It asks about your business.
            Your customers. Your daily fires. It builds a picture of how your
            business runs. Then it does two things:
          </p>

          <div class="grid md:grid-cols-2 gap-5 mb-10">
            <div class="p-6 rounded-2xl bg-white/[0.04] border border-white/10">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-lg bg-brand-blue/20 flex items-center justify-center text-brand-blue font-bold">1</div>
                <h3 class="font-semibold text-white">Gives you the Blueprint.</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed">
                A plan showing every AI worker your business should hire, ranked by impact. <span class="text-gray-200 font-medium">Yours to keep.</span>
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white/[0.04] border border-white/10">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-lg bg-brand-teal/20 flex items-center justify-center text-brand-teal font-bold">2</div>
                <h3 class="font-semibold text-white">Builds your team.</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed">
                The recommended workers are configured for your business, ready to deploy into VibeControl when you choose to.
              </p>
            </div>
          </div>

          <p class="text-gray-400 leading-relaxed mb-8">
            After your Blueprint, you choose how to put your AI team to work.
            Run them inside VibeControl ($97/mo) or take what you learned and
            implement it yourself elsewhere.
            <span class="text-gray-200">Most owners try the platform. Some don't. Either way the Blueprint is yours.</span>
          </p>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <a
              href={BLUEPRINT_URL}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25"
            >
              {CTA_LABEL}
              <ArrowRight className="w-4 h-4" />
            </a>
            <p class="text-sm text-gray-500">Launching soon. Join the list and you'll be invited first.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 5 — PRICING
         ========================= -->
    <section id="pricing" class="relative py-24 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">Pricing</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">What it costs.</h2>
          <p class="text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
            Everyone starts the same way: a <span class="text-white font-semibold">$47 Roleforge Blueprint</span> that maps your AI workforce. From there, run your team inside VibeControl.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Standard -->
          <div class="relative p-8 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md flex flex-col">
            <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-1">Standard</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class="text-5xl font-bold text-white">$97</span>
              <span class="text-gray-400">/mo</span>
            </div>
            <p class="text-gray-400 text-sm mb-6">Solo operator running an AI team.</p>
            <ul class="space-y-3 text-sm text-gray-300 mb-8 flex-1">
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span><span class="text-white font-medium">Unlimited</span> AI workers</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>1 team member</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Credits for a typical month of solo usage</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Mobile app</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Memory &amp; playbooks</span></li>
            </ul>
            <a
              href={BLUEPRINT_URL}
              class="block text-center px-6 py-3 rounded-xl border border-white/20 font-semibold text-white hover:bg-white/10 transition"
            >
              {CTA_LABEL}
            </a>
          </div>

          <!-- Team -->
          <div class="relative p-8 rounded-2xl bg-gradient-to-br from-brand-blue/10 via-white/[0.04] to-brand-teal/10 border border-brand-teal/30 backdrop-blur-md flex flex-col">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-gradient-to-r from-brand-blue to-brand-teal rounded-full text-xs font-semibold text-white shadow-lg shadow-brand-blue/30">
              For small teams
            </div>
            <h3 class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-1">Team</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class="text-5xl font-bold text-white">$297</span>
              <span class="text-gray-400">/mo</span>
            </div>
            <p class="text-gray-400 text-sm mb-6">Humans + AI workers on the same board.</p>
            <ul class="space-y-3 text-sm text-gray-300 mb-8 flex-1">
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span><span class="text-white font-medium">Unlimited</span> AI workers</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Up to 10 team members</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Credits for a typical month of small-team usage</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Shared team workspace</span></li>
              <li class="flex items-start gap-2"><Check className="w-4 h-4 text-brand-teal shrink-0 mt-0.5" /><span>Mobile app, memory &amp; playbooks</span></li>
            </ul>
            <a
              href={BLUEPRINT_URL}
              class="block text-center px-6 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25"
            >
              {CTA_LABEL}
            </a>
          </div>
        </div>

        <p class="text-center text-sm text-gray-500 mt-8">
          $47 one-time for the Blueprint at launch. Choose your plan when you're ready to deploy. Cancel anytime.
        </p>
      </div>
    </section>

    <!-- =========================
         SECTION 6 — FOUNDER
         ========================= -->
    <section id="founder" class="relative py-24 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="rounded-3xl bg-gradient-to-br from-white/[0.04] to-white/[0.02] border border-white/10 p-8 md:p-12 backdrop-blur-md">
          <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-12 items-start">
            <!-- Founder photo -->
            <div class="mx-auto md:mx-0">
              <div class="w-40 h-40 md:w-44 md:h-44 rounded-2xl bg-gradient-to-br from-brand-blue/30 via-brand-teal/20 to-brand-orange/20 border border-white/10 flex items-center justify-center overflow-hidden">
                <div class="text-center px-3">
                  <div class="w-16 h-16 rounded-full bg-white/10 border border-white/20 mx-auto mb-2 flex items-center justify-center text-2xl font-bold text-white">DR</div>
                  <p class="text-xs text-gray-400">Founder photo</p>
                </div>
              </div>
            </div>
            <div>
              <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-2">A founder note</p>
              <h2 class="text-2xl md:text-3xl font-bold mb-5 leading-tight">
                Built by someone who's been cleaning up after small business software for 18 years.
              </h2>
              <div class="space-y-4 text-gray-300 leading-relaxed">
