---
import Layout from '../layouts/Layout.astro';
import {
  ClipboardList,
  Eye,
  UserCheck,
  ShieldCheck,
  Users,
  Brain,
  Settings,
  CheckCircle,
  ArrowRight,
  Check,
  Code,
  Megaphone,
  FolderCog,
  Rocket,
  ListTodo,
} from 'lucide-react';
---
<Layout title="VibeControl — Your AI agents can do the work. VibeControl makes it manageable.">
  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Glow orbs -->
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-blue/20 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-20 right-1/4 w-80 h-80 bg-brand-teal/20 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/2 right-1/3 w-64 h-64 bg-brand-orange/15 rounded-full blur-[100px]"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center py-24">
      <img src="/images/logo-light.png" alt="VibeControl" class="mx-auto h-[7.5rem] md:h-[10.5rem] mb-10" />
      <h1 class="text-4xl md:text-6xl font-bold mb-6 pb-2 bg-gradient-to-r from-white via-brand-blue to-brand-teal bg-clip-text text-transparent leading-tight">
        Your AI agents can do the work.<br />VibeControl makes it manageable.
      </h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-4">
        OpenClaw proved AI can do real tasks — not just chat. VibeControl turns that power into a simple workspace where you can assign tasks to agents (or people), review what gets done, and keep everything organized as you build.
      </p>
      <p class="text-base text-brand-teal mb-10">
        We're launching soon. Sign up for early access and be first in line.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a href="#cta" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25">
          Get Early Access <ArrowRight className="w-4 h-4" />
        </a>
        <a href="#how-it-works" class="px-8 py-3 rounded-xl border border-white/20 font-semibold text-white hover:bg-white/10 transition">
          See How It Works
        </a>
      </div>

      <!-- Micro-line -->
      <p class="text-sm text-gray-500">Built for teams &bull; Approvals + history &bull; Works with your agent setup</p>
    </div>
  </section>

  <!-- TRUST / SOCIAL PROOF -->
  <section class="py-12 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg text-gray-300 mb-6">Built for builders who want a team of AI workers — without the chaos.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {['Self-host friendly', 'Team roles', 'Review & approvals', 'Activity history'].map((badge) => (
          <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm text-gray-400">{badge}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- THE MOMENT -->
  <section class="relative py-24 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-coral/5 to-transparent"></div>
    <div class="relative max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-10">OpenClaw made AI agents real. VibeControl makes them usable.</h2>

      <div class="space-y-6 text-gray-300 leading-relaxed text-lg">
        <p>
          OpenClaw lit the match: AI agents that can actually <em>do</em> things. But once you move past a solo experiment, it gets messy fast.
        </p>
        <ul class="space-y-3 text-gray-400">
          <li class="flex items-start gap-3"><span class="text-brand-coral mt-1">&#x2022;</span> Who's working on what?</li>
          <li class="flex items-start gap-3"><span class="text-brand-coral mt-1">&#x2022;</span> What's done vs. stuck?</li>
          <li class="flex items-start gap-3"><span class="text-brand-coral mt-1">&#x2022;</span> Where do the results live?</li>
          <li class="flex items-start gap-3"><span class="text-brand-coral mt-1">&#x2022;</span> How do you review before it ships?</li>
          <li class="flex items-start gap-3"><span class="text-brand-coral mt-1">&#x2022;</span> How do you share it with a team?</li>
        </ul>
        <p class="text-white font-semibold text-xl">
          VibeControl is the missing layer: a clean place to run your AI team and human team together.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section class="relative py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-10">A task board where your "teammates" can be AI.</h2>

      <div class="space-y-4 text-gray-300 text-lg leading-relaxed">
        <p>Create tasks. Assign them to an AI agent (or a person).</p>
        <p>Agents do the work. You review it. Approve it. Move on.</p>
        <p class="text-white font-semibold text-xl pt-4">
          It feels like running a business — not managing a science experiment.
        </p>
      </div>
    </div>
  </section>

  <!-- CORE BENEFITS -->
  <section class="relative py-24 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-blue/5 to-transparent"></div>
    <div class="relative max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Everything you need to run an AI-powered workflow</h2>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <div class="w-12 h-12 rounded-xl bg-brand-blue/20 flex items-center justify-center mb-5">
            <Eye className="w-6 h-6 text-brand-blue" />
          </div>
          <h3 class="text-xl font-semibold mb-3">Clarity</h3>
          <p class="text-gray-400">A simple board so you always know what's next, what's in progress, and what's done.</p>
        </div>

        <div class="p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <div class="w-12 h-12 rounded-xl bg-brand-teal/20 flex items-center justify-center mb-5">
            <UserCheck className="w-6 h-6 text-brand-teal" />
          </div>
          <h3 class="text-xl font-semibold mb-3">Accountability</h3>
          <p class="text-gray-400">Every task has an owner — human or AI — and a clear trail of what happened.</p>
        </div>

        <div class="p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <div class="w-12 h-12 rounded-xl bg-brand-orange/20 flex items-center justify-center mb-5">
            <ShieldCheck className="w-6 h-6 text-brand-orange" />
          </div>
          <h3 class="text-xl font-semibold mb-3">Confidence</h3>
          <p class="text-gray-400">Review and approve work before it ships. Keep important steps from happening silently.</p>
        </div>

        <div class="p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <div class="w-12 h-12 rounded-xl bg-brand-coral/20 flex items-center justify-center mb-5">
            <Users className="w-6 h-6 text-brand-coral" />
          </div>
          <h3 class="text-xl font-semibold mb-3">Teamwork</h3>
          <p class="text-gray-400">Share context, files, and results — without copying and pasting across chat threads.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works" class="relative py-24 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-blue/5 to-transparent"></div>
    <div class="relative max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">From idea to done (without chaos)</h2>

      <div class="space-y-8">
        {[
          { step: '1', title: 'Add a task', desc: 'What you want done, and what "done" means.' },
          { step: '2', title: 'Assign it', desc: 'Pick an AI agent or a person — same interface, same flow.' },
          { step: '3', title: 'Work gets done', desc: 'Updates and results stay in one place. No chasing across apps.' },
          { step: '4', title: 'Review + approve', desc: 'Check the output, approve it, or request changes — all in context.' },
          { step: '5', title: 'Keep the knowledge', desc: 'So the team gets smarter over time. Less explaining, more shipping.' },
        ].map(({ step, title, desc }) => (
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-brand-blue to-brand-teal flex items-center justify-center text-lg font-bold shadow-lg shadow-brand-blue/25">
              {step}
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">{title}</h3>
              <p class="text-gray-400">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURE HIGHLIGHTS -->
  <section class="relative py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Built for people who want results — and teams that want control</h2>
      <p class="text-gray-400 text-center mb-16 max-w-2xl mx-auto">Everything you need, nothing you don't.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <ClipboardList className="w-7 h-7 text-brand-blue mb-4" />
          <h3 class="text-lg font-semibold mb-2">Task board</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Priorities, due dates, tags. A clear view of everything that needs to happen.</p>
        </div>

        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <UserCheck className="w-7 h-7 text-brand-teal mb-4" />
          <h3 class="text-lg font-semibold mb-2">AI agent teammates</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Specialists for different jobs. Assign work to agents the same way you'd assign it to a person.</p>
        </div>

        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <CheckCircle className="w-7 h-7 text-brand-orange mb-4" />
          <h3 class="text-lg font-semibold mb-2">Approvals</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Review before important work ships. Stay in control of what goes out.</p>
        </div>

        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <Users className="w-7 h-7 text-brand-coral mb-4" />
          <h3 class="text-lg font-semibold mb-2">Team access</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Invite people, set roles. Everyone sees the same board and stays in sync.</p>
        </div>

        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <Eye className="w-7 h-7 text-brand-blue mb-4" />
          <h3 class="text-lg font-semibold mb-2">Activity history</h3>
          <p class="text-gray-400 text-sm leading-relaxed">See what happened, when. A full trail for every task and every update.</p>
        </div>

        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <Brain className="w-7 h-7 text-brand-teal mb-4" />
          <h3 class="text-lg font-semibold mb-2">Shared memory</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Notes and decisions stay with the project. Context carries forward so you're not starting over.</p>
        </div>

        <div class="group md:col-span-2 lg:col-span-1 p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-brand-blue/30 transition-all duration-300">
          <Settings className="w-7 h-7 text-brand-orange mb-4" />
          <h3 class="text-lg font-semibold mb-2">Works with your setup</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Self-hosted runtime and bring-your-own-key options. Your agents, your infrastructure, your rules.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="relative py-24 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-coral/5 to-transparent"></div>
    <div class="relative max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">What people use VibeControl for</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <Code className="w-7 h-7 text-brand-blue mb-4" />
          <h3 class="text-lg font-semibold mb-2">Build and ship software</h3>
          <p class="text-gray-400 text-sm">Features, bugs, releases — with AI agents handling the heavy lifting.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <Megaphone className="w-7 h-7 text-brand-teal mb-4" />
          <h3 class="text-lg font-semibold mb-2">Grow marketing output</h3>
          <p class="text-gray-400 text-sm">Content, landing pages, ads, email — assigned, reviewed, and shipped.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <FolderCog className="w-7 h-7 text-brand-orange mb-4" />
          <h3 class="text-lg font-semibold mb-2">Run operations</h3>
          <p class="text-gray-400 text-sm">Support, documentation, SOPs — keep the machine running smoothly.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <Rocket className="w-7 h-7 text-brand-coral mb-4" />
          <h3 class="text-lg font-semibold mb-2">Launch offers</h3>
          <p class="text-gray-400 text-sm">Research, assets, funnel, follow-up — from idea to live in one workflow.</p>
        </div>

        <div class="md:col-span-2 lg:col-span-1 p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
          <ListTodo className="w-7 h-7 text-brand-blue mb-4" />
          <h3 class="text-lg font-semibold mb-2">Delegate busywork</h3>
          <p class="text-gray-400 text-sm">The tasks you know you should do, but never get to. Hand them off and move on.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONING -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">The simplest way to run a team of AI workers</h2>
      <p class="text-xl text-gray-400">OpenClaw is the spark.</p>
      <p class="text-xl text-white font-semibold">VibeControl is the control center.</p>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section id="pricing" class="relative py-24 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-blue/5 to-transparent"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Start simple. Scale up when you're ready.</h2>
      <div class="space-y-3 text-lg text-gray-300 mb-10">
        <p>Solo builder friendly.</p>
        <p>Team-ready when you grow.</p>
        <p>Built for human + AI collaboration from day one.</p>
      </div>
      <a href="#cta" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25">
        Get Early Access <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="cta" class="py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <div class="p-10 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-md">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Turn AI agents into a real operating system for your business.</h2>
        <p class="text-gray-400 mb-8">If you want AI that actually does the work, you also need a way to manage the work. VibeControl is the easiest way to run an AI-powered team — without losing control.</p>

        <form id="cta-form" action="#" class="flex flex-col gap-4 max-w-lg mx-auto text-left">
          <input type="hidden" name="source" value="vibecontrol-landing" />

          <!-- Name fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input
              type="text"
              name="first_name"
              required
              placeholder="First name"
              class="px-5 py-3 rounded-xl bg-white/10 border border-white/20 backdrop-blur-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-blue/60 transition"
            />
            <input
              type="text"
              name="last_name"
              required
              placeholder="Last name"
              class="px-5 py-3 rounded-xl bg-white/10 border border-white/20 backdrop-blur-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-blue/60 transition"
            />
          </div>

          <!-- Email -->
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full px-5 py-3 rounded-xl bg-white/10 border border-white/20 backdrop-blur-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-blue/60 transition"
          />

          <!-- Interest multi-select -->
          <fieldset>
            <legend class="text-sm text-gray-300 mb-3 font-medium">What are you most excited about?</legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-task-board" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">Task Board</span>
              </label>
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-self-hosted" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">Self-Hosted Runtime</span>
              </label>
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-persistent-memory" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">Shared Memory</span>
              </label>
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-multi-model" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">Multi-Model Support</span>
              </label>
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-team-collab" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">Team Collaboration</span>
              </label>
              <label class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition">
                <input type="checkbox" name="interests" value="interest-multi-agent" class="accent-brand-teal w-4 h-4 shrink-0" />
                <span class="text-sm text-gray-300">AI Agent Teams</span>
              </label>
            </div>
          </fieldset>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full px-8 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25"
          >
            Get Early Access
          </button>
        </form>
        <p id="cta-thanks" class="hidden mt-4 text-brand-teal font-medium">You're on the list! We'll notify you the moment we launch.</p>
        <p id="cta-error" class="hidden mt-4 text-brand-coral font-medium">Something went wrong. Please try again.</p>
        <p class="mt-4 text-gray-500 text-sm">We'll notify you the moment we launch. No spam, just access.</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-white/10 py-10 px-6">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-gray-500 text-sm">
      <p>&copy; {new Date().getFullYear()} BUILD3R LLC. All rights reserved.</p>
      <a href="https://build3r.io" class="hover:text-white transition">BUILD3R.io</a>
    </div>
  </footer>

  <script>
    document.querySelectorAll('#cta-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const container = form.parentElement;
        const thanks = container?.querySelector('[id$="-thanks"]');
        const error = container?.querySelector('[id$="-error"]');
        const btn = form.querySelector('button[type="submit"]');

        // Collect fields
        const first_name = form.querySelector('input[name="first_name"]').value.trim();
        const last_name = form.querySelector('input[name="last_name"]').value.trim();
        const email = form.querySelector('input[name="email"]').value;
        const source = form.querySelector('input[name="source"]')?.value;
        const interests = Array.from(
          form.querySelectorAll('input[name="interests"]:checked')
        ).map(cb => cb.value);

        // Reset error state
        if (error) error.classList.add('hidden');

        // Loading state
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Submitting...';

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, first_name, last_name, source, interests }),
          });

          if (!res.ok) throw new Error('Request failed');

          form.classList.add('hidden');
          if (thanks) thanks.classList.remove('hidden');
        } catch {
          if (error) error.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = originalText;
        }
      });
    });
  </script>
</Layout>
