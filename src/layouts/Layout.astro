---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Self-hosted AI agent execution with task management, team collaboration, and persistent memory. Like OpenClaw, but with a real workflow. BYOK. Early access open." />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-950 text-white antialiased">
    <slot />
  </body>
</html>
