      <a href="https://build3r.io" class="hover:text-white transition">BUILD3R.io</a>
    </div>
  </footer>

  <script>
    document.querySelectorAll('#cta-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const container = form.parentElement;
        const thanks = container?.querySelector('[id$="-thanks"]');
        const error = container?.querySelector('[id$="-error"]');
        const btn = form.querySelector('button[type="submit"]');
        const email = form.querySelector('input[name="email"]').value;
        const source = form.querySelector('input[name="source"]')?.value;

        // Reset error state
        if (error) error.classList.add('hidden');

        // Loading state
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Submitting...';

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source }),
          });

          if (!res.ok) throw new Error('Request failed');

          form.classList.add('hidden');
          if (thanks) thanks.classList.remove('hidden');
        } catch {
          if (error) error.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = originalText;
        }
      });
    });
  </script>
