---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Your AI agents can do the work. VibeControl makes it manageable. A simple workspace to assign tasks to AI agents or people, review results, and keep everything organized." />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-950 text-white antialiased">
    <slot />
  </body>
</html>
