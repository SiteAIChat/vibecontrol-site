---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import { HANDOFF_CTA_LABEL, HANDOFF_URL, REVIEW_URL } from '../lib/cta';
import {
  ArrowRight,
  Check,
  X,
  Inbox,
  PhoneCall,
  HeartHandshake,
  PenLine,
  BarChart3,
  ClipboardList,
  Brain,
  Cloud,
  Users,
  UserCog,
  Scale,
  Sparkles,
  ChevronDown,
  Lock,
  CheckCircle2,
} from 'lucide-react';
---
<Layout
  title="VibeControl | Your AI workforce, running your business"
  description="Hire an AI employee who runs your inbox, follows up with leads, and answers customer questions. One employee, every job. Starts with a $47 AI Workforce Blueprint that maps out the work to hand off."
>
  <SiteNav />

  <main id="top" class="pt-16">
    <!-- =========================
         SECTION 1 — HERO
         ========================= -->
    <section class="relative overflow-hidden min-h-[calc(100svh-4rem)] flex items-center">
      <!-- ambient glow -->
      <div class="absolute top-10 left-1/4 w-[28rem] h-[28rem] bg-brand-blue/20 rounded-full blur-[140px]" aria-hidden="true"></div>
      <div class="absolute bottom-0 right-1/4 w-[26rem] h-[26rem] bg-brand-teal/20 rounded-full blur-[140px]" aria-hidden="true"></div>
      <div class="absolute top-1/3 right-1/3 w-72 h-72 bg-brand-orange/10 rounded-full blur-[120px]" aria-hidden="true"></div>

      <div class="relative w-full max-w-6xl mx-auto px-6 py-12 sm:py-14 text-center">
        <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-white/5 border border-white/10 text-sm sm:text-base text-gray-200 mb-8">
          <span class="w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
          <span class="text-brand-teal font-semibold">Launching Soon</span>
          <span class="text-gray-600">·</span>
          For owners asking where to start with AI
        </div>

        <h1 class="text-[2.6rem] sm:text-6xl md:text-7xl lg:text-[5.25rem] font-bold tracking-tight mb-8 leading-[1.03] text-balance">
          An AI employee that knows your business
          <span class="block bg-gradient-to-r from-brand-blue via-brand-teal to-brand-orange bg-clip-text text-transparent">
            and works with everyone in it.
          </span>
        </h1>

        <p class="text-xl md:text-2xl text-gray-200 max-w-3xl mx-auto mb-12 leading-relaxed">
          It learns how your business runs: your customers, your process,
          your way of doing things. Anyone on your team can hand it work in
          plain English. Nothing technical to learn, and you decide what it
          does on its own.
        </p>

        <div class="flex flex-col items-center gap-5">
          <a
            href={HANDOFF_URL}
            class="group inline-flex items-center gap-3 px-10 py-5 rounded-2xl bg-gradient-to-r from-brand-blue to-brand-teal text-lg md:text-xl font-semibold text-white hover:opacity-90 transition shadow-xl shadow-brand-blue/30"
          >
            {HANDOFF_CTA_LABEL}
            <ArrowRight className="w-6 h-6 group-hover:translate-x-0.5 transition" />
          </a>
          <p class="text-base md:text-lg text-gray-300 max-w-xl leading-relaxed">
            Start with a low-risk working interview. See what your AI employee
            can do before you commit to anything.
            <span class="block mt-2 text-base text-gray-400">$47 once. Nothing renews.</span>
          </p>
        </div>

        <!-- micro-trust row -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm md:text-base text-gray-400">
          <span class="flex items-center gap-2"><Lock className="w-4 h-4 text-brand-teal" /> No credit card to join the list</span>
          <span class="hidden sm:inline text-gray-600">·</span>
          <span class="flex items-center gap-2"><CheckCircle2 className="w-4 h-4 text-brand-teal" /> 14-day Value Promise at launch</span>
          <span class="hidden sm:inline text-gray-600">·</span>
          <span class="flex items-center gap-2"><Sparkles className="w-4 h-4 text-brand-teal" /> First-in-line pricing</span>
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 2 — JTBD COMPARISON
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center mb-16">
          <div>
            <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">What's different about VibeControl</p>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-balance">
              Most AI works for one person.
              <span class="block bg-gradient-to-r from-brand-blue via-brand-teal to-brand-orange bg-clip-text text-transparent">VibeControl works for your whole business.</span>
            </h2>
            <div class="space-y-4 text-gray-300 text-lg leading-relaxed">
              <p>
                Most AI tools start fresh with every person and every chat. Your
                salesperson uses one, your office manager uses another, and
                neither one knows what the other learned. The people who are
                good with AI get a little faster. Everyone else gets nothing. Add
                more tools and you end up coordinating all of them.
              </p>
              <p>
                VibeControl learns how your business actually runs: your
                customers, your process, your standards, and the decisions
                you’ve already made. Everyone on your team works with
                <em class="text-white not-italic font-semibold">the same AI employee and the same understanding of the business</em>,
                whether they’ve used AI before or not.
              </p>
            </div>
          </div>

          <!-- Logo lockup -->
          <div class="relative hidden lg:block">
            <div class="absolute inset-0 bg-[radial-gradient(closest-side,rgba(74,144,217,0.22),rgba(77,201,160,0.12)_55%,transparent_75%)] blur-2xl" aria-hidden="true"></div>
            <div class="relative aspect-square max-w-sm mx-auto rounded-3xl bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/10 backdrop-blur-md p-10 flex items-center justify-center">
              <img src="/images/logos/vibecontrol-dark-500x300.svg" alt="VibeControl" class="w-full h-auto max-w-[16rem] drop-shadow-[0_8px_32px_rgba(74,144,217,0.35)]" />
            </div>
          </div>
        </div>

        <div class="space-y-4">
          {[
            { left: 'Typical AI', leftDoes: 'knows the conversation you’re having with it.', right: 'Knows the business the conversation belongs to.', sub: 'One needs the customer explained again. The other already knows them and their history.' },
            { left: 'Typical AI', leftDoes: 'lives in one person’s chat.', right: 'Works across your team with the same context.', sub: 'One helps whoever is typing. The other takes work from anyone you let ask it.' },
            { left: 'Typical AI', leftDoes: 'works best for people who are good at AI.', right: 'Takes plain-English requests from anyone.', sub: 'One works only as well as you prompt it. The other works from what it already knows about your business.' },
            { left: 'Typical automation', leftDoes: 'moves data when a trigger fires.', right: 'Handles the whole job, inside the rules you set.', sub: 'One breaks when something unexpected happens. The other checks with you first on anything you’ve said needs approval.' },
          ].map((row) => (
            <div class="group relative rounded-2xl bg-white/[0.03] border border-white/10 hover:border-brand-teal/30 transition-all overflow-hidden">
              <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-stretch">
                <!-- LEFT: competitor -->
                <div class="relative p-6 md:p-8">
                  <div class="flex items-start gap-3">
                    <div class="hidden md:flex w-9 h-9 shrink-0 rounded-lg bg-white/[0.04] border border-white/10 items-center justify-center mt-0.5">
                      <X className="w-4 h-4 text-gray-500" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Today</p>
                      <p class="text-gray-300 text-lg leading-snug">
                        <span class="font-bold text-white">{row.left}</span>
                        {' '}<span class="text-gray-400">{row.leftDoes}</span>
                      </p>
                    </div>
                  </div>
                </div>

                <!-- VS divider -->
                <div class="hidden md:flex items-center justify-center px-2">
                  <div class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-950 border border-white/10 text-xs font-bold text-gray-500 tracking-wider">
                    vs
                  </div>
                </div>
                <div class="md:hidden h-px bg-gradient-to-r from-transparent via-white/10 to-transparent mx-6"></div>

                <!-- RIGHT: VibeControl -->
                <div class="relative p-6 md:p-8 bg-gradient-to-br from-brand-blue/[0.08] via-brand-teal/[0.05] to-transparent">
                  <div class="flex items-start gap-3">
                    <div class="hidden md:flex w-9 h-9 shrink-0 rounded-lg bg-brand-teal/15 border border-brand-teal/30 items-center justify-center mt-0.5">
                      <Check className="w-4 h-4 text-brand-teal" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-1.5">VibeControl</p>
                      <p class="text-white text-lg leading-snug font-semibold">{row.right}</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="border-t border-white/5 px-6 md:px-8 py-4 bg-black/20">
                <p class="text-base text-gray-400 leading-relaxed">{row.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 3 — WHAT'S ACTUALLY IN IT
         ========================= -->
    <section class="relative pt-8 pb-24 sm:pt-12 sm:pb-32 px-6 overflow-hidden">
      <div class="absolute top-1/2 -translate-y-1/2 -left-40 w-96 h-96 bg-brand-blue/10 rounded-full blur-[120px]" aria-hidden="true"></div>

      <div class="relative max-w-6xl mx-auto">
        <div class="mb-14 text-center">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">The jobs it takes on</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-balance">
            Give VibeControl a job.
            <span class="block text-gray-400">It already knows how your business works.</span>
          </h2>
          <p class="max-w-3xl mx-auto text-lg md:text-xl text-gray-300 leading-relaxed text-pretty">
            You shouldn’t need one AI for sales, another for support, and
            another for reports. VibeControl takes on every one of those jobs
            as the same AI employee. So the sales follow-up knows what support
            just promised, and Monday’s report already includes both.
          </p>
        </div>

        <!-- Jobs -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-24">
          {[
            { icon: Inbox, color: 'brand-blue', role: 'Office & operations', desc: 'Keeps inboxes, calendars, and recurring tasks moving for everyone. Flags what needs a person.' },
            { icon: PhoneCall, color: 'brand-teal', role: 'Sales', desc: 'Follows up with every lead, books calls, and keeps the CRM current. No deal dies because someone forgot the next step.' },
            { icon: HeartHandshake, color: 'brand-orange', role: 'Customer support', desc: 'Answers routine questions using your policies and each customer’s history. Hands the rest to the right person.' },
            { icon: PenLine, color: 'brand-coral', role: 'Content', desc: 'Drafts emails, newsletters, and posts in the voice your team already uses.' },
            { icon: BarChart3, color: 'brand-blue', role: 'Reporting', desc: 'Pulls the numbers, summarizes the week, and flags what needs attention before anyone goes looking.' },
          ].map(({ icon: Icon, color, role, desc }) => (
            <div class="p-6 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-white/25 hover:bg-white/[0.06] transition group">
              <div class={`w-11 h-11 rounded-xl bg-${color}/15 flex items-center justify-center mb-4 group-hover:scale-105 transition`}>
                <Icon className={`w-5 h-5 text-${color}`} />
              </div>
              <h3 class="text-lg font-semibold text-white mb-2 leading-snug">{role}</h3>
              <p class="text-base text-gray-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>

        <!-- Control -->
        <h3 class="text-2xl md:text-4xl font-bold text-center mb-12 leading-tight text-balance">
          It works across your business.
          <span class="text-gray-400">You decide how.</span>
        </h3>

        <div class="grid md:grid-cols-2 gap-5">
          {[
            { icon: ClipboardList, color: 'brand-blue', title: 'Every job has clear boundaries.', body: 'You define what it’s responsible for, what it can do on its own, and what waits for your approval.' },
            { icon: Brain, color: 'brand-teal', title: 'It remembers how you do things.', body: 'Customers, processes, and decisions don’t disappear when a conversation ends. Bring on a new hire and it can bring them up to speed.' },
            { icon: Users, color: 'brand-orange', title: 'Your whole team works with it.', body: 'Anyone can ask in plain English, from a browser or their phone. Everyone sees what’s handled, what’s in progress, and what’s waiting on a person.' },
            { icon: UserCog, color: 'brand-coral', title: 'You decide who can ask for what.', body: 'Your sales team gets sales help, your office staff gets office help, and sensitive work stays with the people you choose.' },
            { icon: Scale, color: 'brand-blue', title: 'Your people keep the judgment calls.', body: 'It handles the repeatable work. Pricing, strategy, sensitive customer conversations, and exceptions stay with your team.' },
            { icon: Cloud, color: 'brand-teal', title: 'It keeps working when you’re not.', body: 'VibeControl runs on our servers, so approved recurring work keeps moving whether anyone’s laptop is open or not.' },
          ].map(({ icon: Icon, color, title, body }) => (
            <div class="p-7 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md hover:border-white/20 transition">
              <div class="flex items-start gap-4">
                <div class={`w-11 h-11 shrink-0 rounded-xl bg-${color}/15 flex items-center justify-center`}>
                  <Icon className={`w-5 h-5 text-${color}`} />
                </div>
                <div>
                  <h4 class="text-lg font-semibold text-white mb-2 leading-snug">{title}</h4>
                  <p class="text-base text-gray-400 leading-relaxed">{body}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 4 — HOW YOU GET STARTED
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6">
      <div class="max-w-6xl mx-auto">
        <div id="get-started" class="text-center mb-14 scroll-mt-24">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">How you get started</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-balance">
            Start with a working interview.
            <span class="text-gray-400">Judge real work before you hire.</span>
          </h2>
          <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-3xl mx-auto text-pretty">
            We recommend giving your AI employee your website first. It builds
            your new homepage as a private preview, a person on our team
            reviews it, and you see the finished work before you commit to
            anything. Like what it can do? Put it to work across your whole
            business on one of the plans below.
          </p>
        </div>

        <div class="grid md:grid-cols-[1.4fr_1fr] gap-5">
          <!-- Primary: Working Interview -->
          <div class="rounded-3xl bg-gradient-to-br from-brand-blue/10 via-white/[0.03] to-brand-teal/10 border border-brand-teal/30 p-8 md:p-10 backdrop-blur-md flex flex-col">
            <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">$47 once</p>
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-4 leading-tight">The working interview</h3>
            <p class="text-base md:text-lg text-gray-300 leading-relaxed mb-4">
              Your AI employee builds an AI-powered version of your homepage.
              <span class="font-semibold text-white">Keep your current style or ask for a refresh. Your call.</span>
            </p>
            <p class="text-base md:text-lg text-gray-300 leading-relaxed mb-4">
              Same look if you like it, with the fixes your review found. The
              difference is that your AI employee can now update it whenever
              you ask.
            </p>
            <p class="text-base text-gray-400 leading-relaxed mb-6">
              It starts with a free review of your website, which takes about a
              minute.
            </p>
            <ul class="space-y-2.5 text-base text-gray-300 mb-8 flex-1">
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Reviewed by a person before you see it</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Ready within 48 hours of your brief, one revision included</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>The files are yours either way</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>$47 once. Nothing renews.</span></li>
            </ul>
            <a
              href={REVIEW_URL}
              class="group w-full sm:w-auto sm:self-start inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal text-base md:text-lg font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25"
            >
              Start my working interview
              <ArrowRight className="w-5 h-5 group-hover:translate-x-0.5 transition" />
            </a>
          </div>

          <!-- Then: Hire -->
          <div class="rounded-3xl bg-white/[0.03] border border-white/10 p-8 md:p-10 backdrop-blur-md flex flex-col">
            <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">From $97/month</p>
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-4 leading-tight">Hire it</h3>
            <p class="text-base md:text-lg text-gray-300 leading-relaxed flex-1">
              Like the work? Give it the rest of your business: sales
              follow-up, customer support, reporting. It already knows your
              website, and it learns the rest as it goes.
            </p>
            <a href="#pricing" class="mt-8 inline-flex items-center gap-2 text-base font-semibold text-brand-teal hover:text-white transition">
              See plans
              <ArrowRight className="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         SECTION 5 — PRICING
         ========================= -->
    <section class="relative py-24 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div id="pricing" class="text-center mb-16 scroll-mt-24">
          <p class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-3">Pricing</p>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">What it costs.</h2>
          <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed text-pretty">
            Everyone starts the same way: a <span class="text-white font-semibold">$47 working interview</span>. When you like the work, hire it on one of these plans. Month to month, cancel anytime.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Standard -->
          <div class="relative p-8 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md flex flex-col">
            <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-1">Standard</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class="text-5xl font-bold text-white">$97</span>
              <span class="text-gray-400">/mo</span>
            </div>
            <p class="text-gray-300 text-base mb-6">One owner. One AI employee that knows your business.</p>
            <ul class="space-y-3 text-base text-gray-300 mb-6 flex-1">
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span><span class="font-semibold text-white">Any job you want to hand off.</span> No per-job fees.</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Works with your existing AI subscription</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>5,000 credits a month for hosted work. You set the cap.</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>1 user and 1 website</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Mobile app, memory, and playbooks</span></li>
            </ul>
            <p class="text-sm text-gray-400 leading-relaxed mb-6">
              Add a user for $47/mo or a website for $20/mo. Running a second
              business or location? Add a workspace for $47/mo.
            </p>
            <a
              href={REVIEW_URL}
              class="block text-center px-6 py-3.5 rounded-xl border border-white/20 text-base font-semibold text-white hover:bg-white/10 transition"
            >
              Start my working interview
            </a>
          </div>

          <!-- Team -->
          <div class="relative p-8 rounded-2xl bg-gradient-to-br from-brand-blue/10 via-white/[0.04] to-brand-teal/10 border border-brand-teal/30 backdrop-blur-md flex flex-col">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-gradient-to-r from-brand-blue to-brand-teal rounded-full text-xs font-semibold text-white shadow-lg shadow-brand-blue/30">
              For small teams
            </div>
            <h3 class="text-sm font-semibold text-brand-teal uppercase tracking-wider mb-1">Team</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class="text-5xl font-bold text-white">$297</span>
              <span class="text-gray-400">/mo</span>
            </div>
            <p class="text-gray-300 text-base mb-6">Your people and your AI employee on the same board.</p>
            <ul class="space-y-3 text-base text-gray-300 mb-6 flex-1">
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span><span class="font-semibold text-white">Any job you want to hand off.</span> No per-job fees.</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Decide who on your team can ask it for what</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>3 users included, $20/mo each after</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>Works with your existing AI subscription</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>15,000 credits a month for hosted work. You set the cap.</span></li>
              <li class="flex items-start gap-2.5"><Check className="w-5 h-5 text-brand-teal shrink-0 mt-0.5" /><span>2 websites, plus everything in Standard</span></li>
            </ul>
            <p class="text-sm text-gray-400 leading-relaxed mb-6">
              Running a second business or location? Add a workspace for
              $47/mo.
            </p>
            <a
              href={REVIEW_URL}
              class="block text-center px-6 py-3.5 rounded-xl bg-gradient-to-r from-brand-blue to-brand-teal text-base font-semibold text-white hover:opacity-90 transition shadow-lg shadow-brand-blue/25"
            >
              Start my working interview
            </a>
          </div>
        </div>

        <!-- Existing AI subscription -->
        <div class="mt-8 max-w-4xl mx-auto rounded-2xl border border-white/10 bg-white/[0.02] p-8">
          <h3 class="text-xl md:text-2xl font-bold text-white mb-3 leading-snug">
            Already pay for an AI subscription?
            <span class="text-brand-teal">Put it to work.</span>
          </h3>
          <p class="text-base md:text-lg text-gray-300 leading-relaxed">
