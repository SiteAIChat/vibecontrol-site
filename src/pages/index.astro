---
import Layout from '../layouts/Layout.astro';
import {
  ArrowRight,
  BarChart3,
  BriefcaseBusiness,
  ChevronRight,
  FileText,
  Inbox,
  MessageSquareReply,
  ShieldCheck,
  Users,
} from 'lucide-react';

const blueprintUrl = 'https://roleforgeai.com';
const loginUrl = 'https://vibecontrol.app/login';

const cta = {
  label: 'Start with the $47 Blueprint',
  href: blueprintUrl,
};

const comparisons = [
  {
    tool: 'ChatGPT',
    vc: 'VibeControl',
    headline: 'gives you advice.',
    contrast: 'does the work.',
    detail: 'One drafts emails you still have to send. The other answers them.',
  },
  {
    tool: 'Zapier',
    vc: 'VibeControl',
    headline: 'connects your apps.',
    contrast: 'runs your business.',
    detail: 'One moves data between tools. The other makes decisions and takes action.',
  },
  {
    tool: 'Your CRM',
    vc: 'VibeControl',
    headline: 'stores your customers.',
    contrast: 'talks to them.',
    detail: 'One is a database. The other is a sales assistant who never forgets to follow up.',
  },
  {
    tool: 'Your project tool',
    vc: 'VibeControl',
    headline: 'tracks tasks.',
    contrast: 'completes them.',
    detail: 'One is a list. The other is a team.',
  },
  {
    tool: 'A virtual assistant',
    vc: 'VibeControl',
    headline: 'costs $2,000+ a month.',
    contrast: 'costs $97.',
    detail: 'One needs to be hired, trained, managed, and paid. The other shows up already knowing your business.',
  },
];

const workers = [
  {
    icon: Inbox,
    title: 'AI office manager',
    body: 'Reads your inbox, books your meetings, and flags what needs you.',
  },
  {
    icon: MessageSquareReply,
    title: 'AI sales assistant',
    body: 'Follows up with every lead, books calls, and updates your CRM.',
  },
  {
    icon: Users,
    title: 'AI customer support rep',
    body: 'Handles routine customer questions and routes the complex ones to you.',
  },
  {
    icon: FileText,
    title: 'AI content writer',
    body: 'Drafts your emails, newsletters, and follow-up sequences in your voice.',
  },
  {
    icon: BarChart3,
    title: 'AI reports analyst',
    body: 'Pulls your numbers and writes the summary every Monday before you log on.',
  },
];

const platformPoints = [
  {
    title: 'Each worker has a job description.',
    body: 'What they do, what they do not, and how much judgment they are trusted with. Built specifically for your business, not generic templates.',
  },
  {
    title: 'They remember.',
    body: 'Your workers learn your customers, your decisions, and your way of doing things. The longer they work for you, the better they get.',
  },
  {
    title: 'They work while you sleep.',
    body: 'VibeControl runs in the cloud, on our infrastructure. Nothing to install. Your AI team keeps working whether your computer is open or not.',
  },
  {
    title: 'You see everything they are doing.',
    body: 'Open the app from your phone or laptop and see exactly what your AI team has handled, what is in progress, and what is waiting for you.',
  },
  {
    title: 'Nothing happens you did not authorize.',
    body: 'You decide what each worker can do on their own and what needs approval. Drafts can wait for review. Routine replies can send automatically.',
  },
  {
    title: 'You stay in charge of the judgment calls.',
    body: 'AI workers handle routine work end-to-end. Pricing, strategy, and hard customer conversations stay with you.',
  },
];

const blueprintSteps = [
  {
    title: 'Gives you the Blueprint.',
    body: 'A plan showing every AI worker your business should hire, ranked by impact. Yours to keep.',
  },
  {
    title: 'Builds your team.',
    body: 'The recommended workers are configured for your business, ready to deploy into VibeControl when you choose to.',
  },
];

const pricingRows = [
  ['Price', '$97/mo', '$297/mo'],
  ['Best for', 'Solo operator running an AI team', 'Small business with humans + AI workers on the same board'],
  ['AI workers', 'Unlimited', 'Unlimited'],
  ['Team members', '1', 'Up to 10'],
  ['Credits included', 'About a typical month of solo operator usage', 'About a typical month of small team usage'],
  ['Mobile app', 'Included', 'Included'],
  ['Memory & playbooks', 'Included', 'Included'],
  ['Shared team workspace', 'Not included', 'Included'],
];

const proofItems = [
  {
    title: 'Agency, about 12 people, runs on VibeControl daily',
    quote:
      'We use VibeControl to run our own agency: client communications, project status updates, internal reporting, and follow-ups across active engagements.',
    attribution: 'Build3r field use',
  },
  {
    title: 'Online course creator',
    quote:
      'An AI support worker handles student questions, an AI writer drafts weekly emails, and an AI office manager flags the messages that still need a human.',
    attribution: 'Creator workflow example',
  },
  {
    title: 'Small organization with traveling leadership',
    quote:
      'The organization still has to run while leaders are on the road. AI workers handle communication, event responses, weekly updates, and escalation.',
    attribution: 'Operations workflow example',
  },
];

const audiences = [
  ['Agencies', 'Managing client work across multiple engagements.'],
  ['Consultants', 'Drafting proposals, summarizing calls, and researching clients.'],
  ['Coaches and course creators', 'Answering students, drafting emails, and repurposing content.'],
  ['Solo founders', 'Organizing ideas, writing outreach, and documenting processes.'],
  ['Operations-heavy businesses', 'Processing intake, drafting SOPs, and routing tasks.'],
];

const faqs = [
  {
    q: 'How does this work, exactly?',
    a: 'You pay $47 for the Roleforge Blueprint. You have a guided conversation with an AI consultant about your business. It produces a written plan and builds your AI team inside VibeControl, ready to deploy. From there you choose to run them inside the platform or take what you learned and implement it yourself.',
  },
  {
    q: 'Do I have to install anything?',
    a: 'No. VibeControl runs in the cloud. You log in from a browser or mobile app. Your AI workers run on our infrastructure, so they keep working whether your laptop is open or not.',
  },
  {
    q: 'What AI does it use under the hood?',
    a: 'We use leading AI models and route work to the right one for the job. You do not manage API keys, model selection, or subscriptions to other AI services.',
  },
  {
    q: 'What if my Blueprint suggests workers I do not actually want?',
    a: 'You are in control. The Blueprint is a recommendation, not a command. You decide which workers to deploy and which to skip. You can also assign your own jobs to workers anytime.',
  },
  {
    q: 'Can I try the platform before committing to a monthly plan?',
    a: 'Yes. After your Blueprint, you can activate a trial of the Standard plan with starter credits. Details are presented after you complete your Blueprint purchase.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Cancel from your account settings before your billing date to avoid the next charge. We do not lock you in with annual contracts.',
  },
  {
    q: 'Is there a Team plan or just Standard?',
    a: 'Both. Standard is for solo operators. Team is for small businesses with humans and AI workers on the same board. You can upgrade from Standard to Team anytime.',
  },
  {
    q: 'What if I need help setting this up?',
    a: 'Most owners do not. The Blueprint builds your team for you. If you want hands-on help, Build3r offers done-with-you implementation for businesses that need it.',
  },
  {
    q: 'Who is behind this?',
    a: 'Built by Dustin, who has run a small business IT services company since 2008. This is a profitable operator-led business with skin in the game.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'VibeControl',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  description:
    'Hire an AI office manager, sales assistant, or customer support rep for your small business. Starts with a $47 Blueprint that maps your AI workforce and builds your team.',
  offers: [
    {
      '@type': 'Offer',
      name: 'Roleforge Blueprint',
      price: '47',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'VibeControl Standard',
      price: '97',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        billingDuration: 'P1M',
      },
    },
    {
      '@type': 'Offer',
      name: 'VibeControl Team',
      price: '297',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        billingDuration: 'P1M',
      },
    },
  ],
};
---
<Layout
  title="VibeControl — Your AI workforce, running your business"
  description="Hire an AI office manager, sales assistant, or customer support rep for your small business. Starts with a $47 Blueprint that maps your AI workforce and builds your team."
  schema={schema}
>
  <header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 md:px-8">
      <a href="#" class="flex items-center gap-3" aria-label="VibeControl home">
        <img src="/images/logo-dark.png" alt="VibeControl" class="h-9 w-auto" />
      </a>
      <div class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
        <a href="#pricing" class="transition hover:text-slate-950">Pricing</a>
        <a href="#about" class="transition hover:text-slate-950">About</a>
        <a href={loginUrl} class="transition hover:text-slate-950">Login</a>
      </div>
      <a
        href={cta.href}
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800"
      >
        {cta.label}
        <ArrowRight className="h-4 w-4" />
      </a>
    </nav>
  </header>

  <div
    id="sticky-cta"
    class="fixed inset-x-0 top-[65px] z-40 hidden border-b border-slate-200 bg-white/95 px-5 py-3 shadow-sm backdrop-blur md:top-[66px]"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
      <p class="hidden text-sm font-medium text-slate-700 sm:block">$47 one-time. Your AI workforce mapped and configured.</p>
      <a
        href={cta.href}
        class="ml-auto inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800"
      >
        {cta.label}
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>
  </div>

  <main class="bg-white text-slate-950">
    <section id="hero" class="relative overflow-hidden border-b border-slate-200">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(77,201,160,0.16),transparent_30%),radial-gradient(circle_at_80%_5%,rgba(74,144,217,0.18),transparent_28%)]"></div>
      <div class="relative mx-auto grid min-h-[calc(100vh-66px)] max-w-7xl items-center gap-12 px-5 py-16 md:grid-cols-[1.05fr_0.95fr] md:px-8 lg:py-20">
        <div class="max-w-3xl">
          <h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-normal text-slate-950 md:text-7xl">
            Your business doesn’t need more software. It needs more workers.
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-700 md:text-xl">
            VibeControl gives you an AI workforce that actually runs the work — answers your emails, follows up with leads, keeps your CRM clean, writes your reports. For less than a part-time VA.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={cta.href}
              class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-slate-950 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-slate-950/15 transition hover:bg-slate-800"
            >
              {cta.label}
              <ArrowRight className="h-5 w-5" />
            </a>
            <p class="max-w-md text-sm leading-6 text-slate-500">
              A $47 guided session that maps your AI workforce and shows you the workers your business should hire first.
            </p>
          </div>
        </div>

        <div class="relative">
          <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/12">
            <div class="rounded-md border border-slate-200 bg-slate-50">
              <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">VibeControl</p>
                  <p class="mt-1 text-sm font-semibold text-slate-950">AI workforce dashboard</p>
                </div>
                <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">
                  <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                  5 workers active
                </div>
              </div>
              <div class="grid gap-3 p-4 lg:grid-cols-[0.8fr_1.2fr]">
                <div class="space-y-3">
                  {workers.slice(0, 3).map(({ icon: Icon, title }, index) => (
                    <div class="rounded-lg border border-slate-200 bg-white p-3">
                      <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-950 text-white">
                          <Icon className="h-5 w-5" />
                        </div>
                        <div>
                          <p class="text-sm font-semibold text-slate-950">{title}</p>
                          <p class="text-xs text-slate-500">{index === 0 ? '12 tasks handled' : index === 1 ? '8 leads followed up' : '4 customer replies'}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4">
                  <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-sm font-semibold text-slate-950">Today’s work</h2>
                    <span class="text-xs font-medium text-slate-500">Live queue</span>
                  </div>
                  <div class="space-y-3">
                    {[
                      ['Office Manager', 'Booked two sales calls and flagged one pricing question.', 'Needs your review'],
                      ['Sales Assistant', 'Sent follow-up to every open lead from yesterday.', 'Done'],
                      ['Reports Analyst', 'Drafted Monday revenue summary with notes.', 'In progress'],
                      ['Content Writer', 'Prepared nurture sequence draft in your voice.', 'Ready to review'],
                    ].map(([worker, task, status]) => (
                      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                        <div class="flex items-center justify-between gap-3">
                          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">{worker}</p>
                          <span class:list={[
                            'rounded-md px-2 py-1 text-[11px] font-semibold',
                            status === 'Done' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-700',
                          ]}>{status}</span>
                        </div>
                        <p class="mt-2 text-sm leading-5 text-slate-700">{task}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="mt-4 text-center text-sm text-slate-500">The VibeControl dashboard. Your AI team’s work, visible.</p>
        </div>
      </div>
    </section>

    <section class="px-5 py-20 md:px-8 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2 class="text-4xl font-semibold tracking-normal text-slate-950 md:text-5xl">What’s different about VibeControl</h2>
          <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600">
            <p>You’ve probably already tried AI somewhere in your business. Most owners have.</p>
            <p>ChatGPT for drafting things. Maybe an AI feature inside your CRM. Maybe an automation tool. They help — but the work still ends up back on your plate.</p>
            <p>That’s because every AI tool you’ve used so far has been built to <em>help you think</em> about work. VibeControl is built to <em>do the work</em>.</p>
          </div>
        </div>

        <div class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
          {comparisons.map((item) => (
            <div class="grid gap-4 py-6 md:grid-cols-[1fr_1.15fr] md:items-center">
              <p class="text-xl font-semibold text-slate-950">
                {item.tool} <span class="font-normal text-slate-500">{item.headline}</span>
              </p>
              <div>
                <p class="text-xl font-semibold text-slate-950">
                  {item.vc} <span class="font-normal text-slate-500">{item.contrast}</span>
                </p>
                <p class="mt-2 text-slate-600"><em>{item.detail}</em></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 px-5 py-20 text-white md:px-8 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
          <div>
            <h2 class="text-4xl font-semibold tracking-normal md:text-5xl">Your AI workforce, working</h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              VibeControl runs an AI team for your business. You assign work the way you’d assign it to a person — and the work gets done.
            </p>
            <p class="mt-8 text-xl font-semibold">Hire workers for the jobs that fill your day.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {workers.map(({ icon: Icon, title, body }) => (
              <div class="rounded-lg border border-white/10 bg-white/[0.04] p-5">
                <Icon className="h-6 w-6 text-brand-teal" />
                <h3 class="mt-4 text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-300">{body}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {platformPoints.map((point) => (
            <div class="rounded-lg border border-white/10 bg-white/[0.04] p-5">
              <h3 class="text-lg font-semibold text-white">{point.title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-300">{point.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-20 md:px-8 lg:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <h2 class="text-4xl font-semibold tracking-normal text-slate-950 md:text-5xl">One door in. The Blueprint.</h2>
          <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600">
            <p>The fastest way to find out what VibeControl can do for your business is through Roleforge — a $47 guided session that maps the AI workforce your business actually needs.</p>
            <p>You sit down with an AI consultant. It asks about your business, your customers, and your daily fires. It builds a picture of how your business runs.</p>
          </div>
          <a
            href={cta.href}
            class="mt-8 inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-slate-950 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-slate-950/15 transition hover:bg-slate-800"
          >
            {cta.label}
            <ArrowRight className="h-5 w-5" />
          </a>
        </div>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 md:p-6">
          <div class="grid gap-4 md:grid-cols-2">
            {blueprintSteps.map((step, index) => (
              <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-slate-950 text-lg font-semibold text-white">{index + 1}</div>
                <h3 class="text-xl font-semibold text-slate-950">{step.title}</h3>
                <p class="mt-3 leading-7 text-slate-600">{step.body}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 leading-7 text-slate-600">
            After your Blueprint, choose how to put your AI team to work. Run them inside VibeControl or take what you learned and implement it yourself elsewhere. Either way the Blueprint is yours.
          </p>
        </div>
      </div>
    </section>

    <section id="pricing" class="border-y border-slate-200 bg-slate-50 px-5 py-20 md:px-8 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-4xl font-semibold tracking-normal text-slate-950 md:text-5xl">What it costs</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            Everyone starts the same way: a $47 Roleforge Blueprint that maps your AI workforce. From there, run your team inside VibeControl at $97/mo or $297/mo.
          </p>
        </div>
        <div class="mt-12 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[760px] text-left text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-white">
                <th class="w-1/3 px-5 py-4 text-slate-500"></th>
                <th class="px-5 py-4 text-lg font-semibold text-slate-950">Standard</th>
                <th class="px-5 py-4 text-lg font-semibold text-slate-950">Team</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {pricingRows.map(([label, standard, team]) => (
                <tr>
                  <th class="px-5 py-4 font-semibold text-slate-950">{label}</th>
                  <td class="px-5 py-4 leading-6 text-slate-600">{standard}</td>
                  <td class="px-5 py-4 leading-6 text-slate-600">{team}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-8 text-center">
          <a
            href={cta.href}
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-slate-950 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-slate-950/15 transition hover:bg-slate-800"
          >
            {cta.label}
            <ArrowRight className="h-5 w-5" />
          </a>
          <p class="mt-3 text-sm text-slate-500">$47 one-time. Choose your plan when you’re ready to deploy. Cancel anytime.</p>
        </div>
      </div>
    </section>

    <section id="about" class="px-5 py-20 md:px-8 lg:py-28">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-center">
        <div class="rounded-lg border border-slate-200 bg-slate-100 p-5">
          <div class="aspect-[4/5] rounded-lg bg-[linear-gradient(135deg,#e2e8f0,#f8fafc)] p-6">
            <div class="flex h-full flex-col justify-end rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
              <BriefcaseBusiness className="h-9 w-9 text-slate-950" />
              <p class="mt-5 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Founder</p>
              <p class="mt-2 text-3xl font-semibold text-slate-950">Dustin</p>
              <p class="mt-3 leading-6 text-slate-600">18 years cleaning up after small business software.</p>
            </div>
          </div>
        </div>
        <div>
          <h2 class="text-4xl font-semibold tracking-normal text-slate-950 md:text-5xl">
            Built by someone who’s been cleaning up after small business software for 18 years.
          </h2>
          <div class="mt-7 space-y-5 text-lg leading-8 text-slate-600">
            <p>I’m Dustin. I built VibeControl.</p>
            <p>I’ve spent 18 years running an IT services company for small businesses. Most of what I’ve done is fix things owners were sold that didn’t work — software promises, productivity hacks, and more recently AI tools. The cycle repeats.</p>
            <p>VibeControl is what I wish I’d had to recommend to my clients for the last decade. AI workers that actually do the work. Hired, trained, ready to go.</p>
            <p>I also run an AI agency, Build3r, for the small number of businesses that want this set up for them personally. Everyone else uses VibeControl directly. That’s the deal.</p>
          </div>
        </div>
      </div>
    </section>

